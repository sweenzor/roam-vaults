{
  "name": "roam-vaults",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Vaults for Roam Research: see notes from your Obsidian-style vaults in your Roam graph.",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:browser": "npm run build && node test/browser-smoke.mjs",
    "bench:memory": "npm run build && node test/memory-bench.mjs"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "ignore": "7.0.14"
  }
}
